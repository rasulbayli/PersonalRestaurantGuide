<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.PRG.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <!-- TODO Milestone 3: Maps SDK + Fused Location replace this placeholder. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/map_placeholder"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="88dp">

            <ImageView
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_map"
                android:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/map_coming_soon"
                android:textAppearance="@style/TextAppearance.PRG.Title" />

            <TextView
                android:id="@+id/txtMapName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.PRG.Body" />

            <TextView
                android:id="@+id/txtMapAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.PRG.Caption" />

            <TextView
                android:id="@+id/txtZoomLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:textAppearance="@style/TextAppearance.PRG.Caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/spacing_md"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomIn"
                style="@style/Widget.PRG.Button"
                android:layout_width="@dimen/zoom_button_size"
                android:layout_height="@dimen/zoom_button_size"
                android:contentDescription="@string/zoom_in"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="@dimen/zoom_button_size"
                android:minHeight="@dimen/zoom_button_size"
                android:padding="0dp"
                android:text="@string/zoom_in_symbol" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomOut"
                style="@style/Widget.PRG.Button"
                android:layout_width="@dimen/zoom_button_size"
                android:layout_height="@dimen/zoom_button_size"
                android:layout_marginTop="@dimen/spacing_sm"
                android:contentDescription="@string/zoom_out"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="@dimen/zoom_button_size"
                android:minHeight="@dimen/zoom_button_size"
                android:padding="0dp"
                android:text="@string/zoom_out_symbol" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGetDirections"
        style="@style/Widget.PRG.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        android:text="@string/get_directions"
        app:icon="@drawable/ic_directions" />
</LinearLayout>
